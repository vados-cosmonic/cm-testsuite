load(":defs.bzl", "download_rust_host", "host_build_tools", "host_rust_triple")
load(":releases.bzl", "RUST_VERSION")
load(":sdk.bzl", "rust_sdk")

_TRIPLE = host_rust_triple()
_TOOLS = host_build_tools()

download_rust_host(name = "host", triple = _TRIPLE)

rust_sdk(
    name = "sdk",
    script = "sdk.sh",
    distribution = ":host",
    triple = _TRIPLE,
    version = RUST_VERSION,
    bash = _TOOLS.bash,
    env = _TOOLS.env,
    visibility = ["PUBLIC"],
)
